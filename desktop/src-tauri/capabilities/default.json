{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core window capabilities plus the folder-open dialog; no fs/shell plugin surface.",
  "windows": [
    "main",
    "fda-helper"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "drag:default",
    "dialog:allow-open"
  ]
}
